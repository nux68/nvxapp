# Modello dei file di ambiente per docker compose (punto 9 e sezione 10 di nvxapp.server/docs/ANALISI_DOCKER.md).
# Copiarlo nella stessa cartella e compilarlo:
#   DockerLocale.env  PC (Docker Desktop), usato dal profilo di pubblicazione DockerLocale
#                     e dai comandi con: docker compose --env-file DockerLocale.env ...
#   DockerVps.env     server: si copia sul VPS come /opt/nvxapp/.env (chmod 600)
# Contengono segreti: esclusi da git (*.env), mai condivisi.
# Per generare password e chiavi: openssl rand -hex 32
# Attenzione: niente ";" nelle password di Postgres (finiscono in una stringa di connessione).

# --- profilo ---------------------------------------------------------------
# PC di sviluppo (Windows, separatore ";"):
COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml
# Server Linux (separatore ":"):
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# tag dell'immagine da avviare (sul server: quello caricato con docker load)
NVXAPP_TAG=latest

# --- segreti obbligatori -----------------------------------------------------
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# firma dei token di login, almeno 32 caratteri (se cambia, tutti rifanno il login)
NVXAPP_JwtParameter__Key=

# --- segreti facoltativi -----------------------------------------------------
# chiave SMTP di Brevo: senza, le email (conferma registrazione, reset password) non partono
NVXAPP_Email__Password=
# chiave del provider AI in uso (AI:UseLLM): senza, la chat AI non risponde
NVXAPP_AI__AI_groq__ApiKey=
NVXAPP_AI__AI_openrouter__ApiKey=

# --- indirizzo pubblico ------------------------------------------------------
# indirizzo usato nei link delle email (locale: https://LAN_IP:8443, oppure http://localhost:8080)
APP_PUBLIC_URL=
# solo PC: IP del PC nella rete locale, per l'https di Caddy su https://LAN_IP:8443 (es. 192.168.0.227)
# (fissarlo con una prenotazione DHCP sul router: se cambia, cambia anche il certificato)
LAN_IP=
# solo server: dominio con record DNS A verso il server ed email per Let's Encrypt
APP_DOMAIN=
ACME_EMAIL=

# --- facoltativi ---------------------------------------------------------------
# nome del database (creato al primo avvio)
#POSTGRES_DB=nvxapp
# true = uno schema per azienda; si decide al PRIMO avvio su database vuoto e poi non cambia piu'
#NVXAPP_DbParameter__MultiTenant=true
#NVXAPP_Swagger__Enabled=false
# porte del profilo locale
#APP_PORT=8080
#PG_PORT=5434
#RABBITMQ_UI_PORT=15672
# porta https: profilo locale 8443, profilo server 443 (HTTP_PORT solo server)
#HTTP_PORT=80
#HTTPS_PORT=443

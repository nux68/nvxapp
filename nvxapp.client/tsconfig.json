/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    
    "strictNullChecks": false,
    "esModuleInterop": true,
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "useDefineForClassFields": false,
    // per l'editor: describe/it/expect dei file di test (tsconfig.app.json li toglie con "types": [])
    "types": [ "jasmine" ]
  },
  // Tutti i sorgenti con queste opzioni, per l'editor (Visual Studio 2026): con "files": [] e "references"
  // l'editor non applicava queste opzioni e segnalava centinaia di errori inesistenti (pacchetti non trovati,
  // controlli strict sui null, describe/it/expect sconosciuti nei .spec.ts: con TypeScript 6 i tipi non si
  // caricano piu' in automatico, per questo "types": [ "jasmine" ] sopra).
  // La build e i test usano tsconfig.app.json e tsconfig.spec.json, che ridefiniscono file e tipi.
  "include": [
    "src/**/*.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}

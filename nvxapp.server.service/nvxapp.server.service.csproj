<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- testi dei manuali utente (Manuals/<codice>.<lingua>.md), letti da UserManualMarkdownProvider; WithCulture=false: il suffisso .it/.en non e' una cultura dei satelliti -->
  <ItemGroup>
    <EmbeddedResource Include="Manuals\**\*.md" WithCulture="false" />
    <EmbeddedResource Include="Manuals\img\*.jpg;Manuals\img\*.png" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- tipi ASP.NET Core (Identity, Http, SignalR) dal framework, al posto dei pacchetti legacy 2.x -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="17.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 6.2.4 = ultima versione MIT: dalla 6.5.0 la licenza e' AGPL-3.0 o commerciale (senza licenza caricata la libreria si blocca) -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nvxapp.server.data\nvxapp.server.data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- programma di prova delle frasi della chat (tools/ChatAiPhraseTest): usa ChatAIService.ProcessMessageAsync -->
    <InternalsVisibleTo Include="ChatAiPhraseTest" />
  </ItemGroup>

</Project>

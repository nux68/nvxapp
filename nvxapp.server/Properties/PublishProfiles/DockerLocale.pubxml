<?xml version="1.0" encoding="utf-8"?>
<!--
Pubblicazione su Docker locale (Docker Desktop): al termine del publish lancia, dalla cartella della solution,
docker compose up con il file di ambiente DockerLocale.env e le opzioni -d e build (target DockerLocaleComposeUp qui sotto).
Ricostruisce l'immagine dal codice corrente (anche modifiche non committate) e ricrea solo il container
dell'app; Postgres e RabbitMQ restano accesi con i loro dati. App su http://localhost:8080.
Prerequisiti: Docker Desktop avviato e file DockerLocale.env nella cartella della solution (copia di .env.example,
sezione 10 di nvxapp.server/docs/ANALISI_DOCKER.md).

Il publish su cartella (obj\DockerLocale) serve solo a Visual Studio: l'immagine la compila il Dockerfile.
AngularBuilt=true salta la build Angular del csproj, che il Dockerfile fa gia'.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>obj\DockerLocale\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>http://localhost:8080</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <ProjectGuid>ec0f2df9-9e0e-4f4e-adb7-0900fe34a5f9</ProjectGuid>
    <SelfContained>false</SelfContained>
    <TargetFramework>net10.0</TargetFramework>
    <_TargetId>Folder</_TargetId>
    <AngularBuilt>true</AngularBuilt>
    <NvxSolutionDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</NvxSolutionDir>
    <!-- file di ambiente di docker compose (profilo locale, password, chiavi), escluso da git -->
    <NvxEnvFile>DockerLocale.env</NvxEnvFile>
  </PropertyGroup>

  <Target Name="DockerLocaleComposeUp" AfterTargets="Publish">
    <Error Condition="!Exists('$(NvxSolutionDir)\$(NvxEnvFile)')"
           Text="Manca il file $(NvxEnvFile) in $(NvxSolutionDir): copiare .env.example in $(NvxEnvFile) e compilarlo (sezione 10 di ANALISI_DOCKER.md)." />

    <Exec Command="docker info" StandardOutputImportance="Low" StandardErrorImportance="Low" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="NvxDockerInfoExitCode" />
    </Exec>
    <Error Condition="'$(NvxDockerInfoExitCode)' != '0'" Text="Docker non risponde: avviare Docker Desktop e ripetere la pubblicazione." />

    <Message Importance="High" Text="Docker locale: docker compose --env-file $(NvxEnvFile) up -d --build (la prima volta alcuni minuti)..." />
    <!-- IgnoreStandardErrorWarningFormat: docker scrive l'avanzamento su stderr; conta solo il codice di uscita -->
    <Exec Command="docker compose --env-file $(NvxEnvFile) up -d --build" WorkingDirectory="$(NvxSolutionDir)"
          StandardOutputImportance="High" StandardErrorImportance="High" IgnoreStandardErrorWarningFormat="true" />
    <Message Importance="High" Text="Docker locale aggiornato: http://localhost:8080 (log: docker compose --env-file $(NvxEnvFile) logs -f nvxapp)" />
  </Target>
</Project>

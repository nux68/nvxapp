{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // segreti (connessione DB, chiave JWT, password): variabili d'ambiente NVXAPP_..., vedi appsettings.json

  "JwtParameter": {

    "Issuer": "https://localhost:7146",
    "Audience": "https://localhost:4200",
    "ExpireMinutes": 1200
  },

  "RabbitQm": {

    "Connection": {
      "HostName": "127.0.0.1",
      "Port": 5672,
      "UserName": "rabbit"
    }

  },

  "RunTime": {
    "Port": 7146,
    "UseHttps": true
  },

  // sviluppo: il client gira con ng serve su un'altra porta, quindi serve CORS
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },

  "Swagger": {
    "Enabled": true,
    "RoutePrefix": "swagger"
  }



}

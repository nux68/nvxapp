<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetCore.AutoRegisterDi" Version="2.2.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.PostgreSQL" Version="2.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
	
  </ItemGroup>

	
	<ItemGroup>
		<ProjectReference Include="..\nvxapp.server.data\nvxapp.server.data.csproj" />
		<ProjectReference Include="..\nvxapp.server.service\nvxapp.server.service.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Logs\" />
	</ItemGroup>

	<!-- PULIZIA WWWROOT SOLO IN DEBUG -->
	<Target Name="CleanWwwrootDebug" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="powershell -Command &quot;if (Test-Path wwwroot) { Get-ChildItem wwwroot | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }&quot;" />
	</Target>

	<!-- BUILD ANGULAR E COPIA IN wwwroot SOLO IN RELEASE/PUBLISH -->
	<Target Name="BuildAngular" BeforeTargets="PrepareForPublish;WebPublish"
					Condition="'$(Configuration)' == 'Release' AND '$(AngularBuilt)' != 'true'">

		<!-- Flag per evitare doppia esecuzione se entrambi i target scattano -->
		<PropertyGroup>
			<AngularBuilt>true</AngularBuilt>
		</PropertyGroup>

		<!-- Elimina la cache di Angular per forzare ricompilazione completa -->
		<RemoveDir Directories="$(MSBuildProjectDirectory)/../nvxapp.client/.angular/cache" />

		<!-- Build Angular -->
		<Exec Command="npx ng build" WorkingDirectory="$(MSBuildProjectDirectory)/../nvxapp.client" StandardOutputImportance="High" StandardErrorImportance="High">
			<Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
		</Exec>
		<Error Condition="'$(ErrorCode)' != '0'" Text="La build Angular è fallita. Controlla l'output." />

		<!-- Pulisce wwwroot dai vecchi bundle prima di copiare i nuovi -->
		<RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
		<MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />

		<!-- Copia l'output Angular in wwwroot — l'SDK ASP.NET Core lo includerà automaticamente nel publish -->
		<ItemGroup>
			<AngularOutputFiles Include="$(MSBuildProjectDirectory)/../nvxapp.client/www/**/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(AngularOutputFiles)"
					DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)"
					SkipUnchangedFiles="false" />

	</Target>





</Project>

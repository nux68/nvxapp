{
  "Logging": {

    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Serilog": "Information" // Trace, Debug, Information, Warning
    },

    "LogType": {
      "LogOnFile": "true",
      "LogOnDB": "false"
    }

  },

  "AllowedHosts": "*",

  // SEGRETI: i valori vuoti qui sotto ("") NON vanno compilati in questo file (finirebbe in git).
  // Si impostano con variabili d'ambiente con prefisso NVXAPP_ e "__" al posto di ":",
  // es. NVXAPP_JwtParameter__Key (script: docs/imposta-variabili-nvxapp.ps1, vedi docs/ANALISI_DOCKER.md punto 7).
  // Obbligatori connessione DB e chiave JWT: senza, l'app non parte e indica la variabile mancante.

  "connectionStrings": {
    // segreto: NVXAPP_ConnectionStrings__nvxappDbContext
    // es. Server=localhost;Port=5432;Database=nvxapp_V2;User Id=postgres;Password=...;Include Error Detail=true;
    "nvxappDbContext": ""
  },

  "JwtParameter": {
    // segreto: NVXAPP_JwtParameter__Key (almeno 32 caratteri; se cambia, tutti devono rifare il login)
    "Key": "",
    "Issuer": "http://192.168.0.227:8146",
    "Audience": "http://192.168.0.227:4200",
    "ExpireMinutes": 1200
  },

  "DbParameter": {
    // true = uno schema PostgreSQL per azienda. Si decide al PRIMO avvio su database vuoto:
    // viene salvato nel database e non si puo' piu' cambiare (vedi Note/Migrazioni.txt).
    "MultiTenant": true
  },

  "Hangfire": {
    "UseHangfire": false
  },

  "SignalR": {
    "UseSignalR": true
  },

  /*
  phi4 
  qwen2.5:0.5b
  qwen2.5:3b

  */

  "AI": {

    "UseLLM": "AI_groq",
    "MaxHistoryTurns": "50",

    // ApiKey: segreto, obbligatoria solo per il provider indicato in UseLLM
    "AI_local": {
      "model": "phi4",
      "Url": "http://localhost:11434/api/",
      "method": "chat"
    },

    "AI_openrouter": {
      "Url": "https://openrouter.ai",
      //"model": "google/gemma-4-26b-a4b-it:free",
      "model": "arcee-ai/trinity-large-thinking:free",
      "method": "/api/v1/chat/completions",
      // segreto: NVXAPP_AI__AI_openrouter__ApiKey
      "ApiKey": ""
    },

    "AI_groq": {
      "Url": "https://api.groq.com",
      "model": "openai/gpt-oss-120b",
      "method": "/openai/v1/chat/completions",
      // segreto: NVXAPP_AI__AI_groq__ApiKey
      "ApiKey": ""
    },

    "AI_deepseek": {
      "Url": "https://api.deepseek.com",
      // deepseek-chat (veloce) oppure deepseek-reasoner (ragionamento, piu' lento)
      "model": "deepseek-chat",
      "method": "/chat/completions",
      // DeepSeek accetta solo json_object (non json_schema)
      "ResponseFormat": "json_object",
      // segreto: NVXAPP_AI__AI_deepseek__ApiKey
      "ApiKey": ""
    }


  },




  "RabbitQm": {
    "Connection": {
      "HostName": "192.168.0.227",
      "Port": 5672,
      "UserName": "rabbit",
      // segreto: NVXAPP_RabbitQm__Connection__Password
      "Password": ""
    }
  },

  // Culture: formato di date e numeri del server (anche fuori dalle richieste: job, export).
  // TimeZone: fuso orario di DateTime.Now (ID IANA); su Linux/Docker viene applicato, su Windows resta quello
  // della macchina e se diverso si scrive un avviso nel log. Vuoti = impostazioni della macchina.
  "RunTime": {
    "Port": 8146,
    "UseHttps": false,
    "Culture": "it-IT",
    "TimeZone": "Europe/Rome"
  },

  // app dietro un reverse proxy che termina HTTPS (es. nginx/Traefik/Caddy in Docker): IP del client e schema
  // originali dagli header X-Forwarded-For / X-Forwarded-Proto. Lasciare false in debug e su IIS.
  // KnownProxies (es. "172.18.0.2") / KnownNetworks (es. "172.18.0.0/16"): da chi accettare gli header;
  // entrambi vuoti = da chiunque (solo se la porta dell'app e' raggiungibile unicamente dal proxy).
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },

  // origini (es. "https://app.miosito.it") che possono chiamare API e SignalR da un altro indirizzo.
  // Vuoto = solo la stessa origine: il client servito dal server stesso non ne ha bisogno. "*" = qualsiasi (solo sviluppo)
  "Cors": {
    "AllowedOrigins": []
  },

  // documentazione delle API (Swagger UI su /<RoutePrefix>): in produzione spenta
  "Swagger": {
    "Enabled": false,
    "RoutePrefix": "docs"
  },

  // invio email (es. link di conferma della registrazione) via SMTP: Brevo -> smtp-relay.brevo.com:587.
  // User: login SMTP di Brevo. Password: la chiave SMTP di Brevo, segreto: NVXAPP_Email__Password.
  // FromAddress: mittente verificato su Brevo. Security: StartTls | SslOnConnect | None (server di prova locale).
  "Email": {
    "Host": "smtp-relay.brevo.com",
    "Port": 587,
    "Security": "StartTls",
    "User": "bf1d55001@smtp-brevo.com",
    "Password": "",
    "FromAddress": "nello68@hotmail.com",
    "FromName": "SiSignore"
  },

  // indirizzo pubblico del sito, per i link nelle email (es. https://miosito.it);
  // vuoto = l'origine della pagina che fa la richiesta (va bene in sviluppo)
  "App": {
    "PublicUrl": ""
  }


}

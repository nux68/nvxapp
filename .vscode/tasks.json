{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compila Backend (.NET Build)",
            "type": "shell", // Cambiato a shell per gestire meglio la cartella di lavoro
            "command": "dotnet build",
            "options": {
                "cwd": "${workspaceFolder}" // 🚀 IMPORTANTE: Compila tutto dalla radice (progetto + servizi)
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Avvia Frontend (Ionic Serve)",
            "type": "shell",
            "command": "ionic serve --port 4200 --no-open",
            "options": {
                "cwd": "${workspaceFolder}/nvxapp.client"
            },
            "isBackground": true,
            "presentation": {
                "group": "avvia-soluzione",
                "reveal": "always",
                "panel": "dedicated"
            },
            // MODIFICATO: Ora il problemMatcher ha sia il background che il pattern richiesto
            "problemMatcher": {
                "owner": "typescript",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Compiled successfully|Development server running|Local:"
                },
                "pattern": {
                    "regexp": "^([^\\s].*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(TS\\d+)\\s*:\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            }
        }
    ]
}